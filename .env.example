# Phase 6 Module 14 (Production Readiness). Copy to `.env` (same directory
# as docker-compose.yml) before running `docker compose up`. Every value
# here is a dev-safe placeholder or blank optional -- see
# apps/api/app/core/config.py (Settings) for the authoritative list of
# every environment variable the application itself reads; this file only
# covers the subset docker-compose.yml/.prod.yml substitute via `${VAR}`.

# --- Postgres ---
POSTGRES_DB=nurseryverse
POSTGRES_USER=nurseryverse
POSTGRES_PASSWORD=nurseryverse_dev_password

# --- Third-party services (optional in dev -- each feature that needs one
# of these degrades gracefully / logs-and-no-ops when unset; see the
# corresponding Settings field's own docstring in app/core/config.py for
# which module that applies to) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Web (Next.js frontend, docker-compose.yml's `web` service) ---
# Dev default: points the browser's API calls straight at the api service's
# published debug port (api publishes 8000; the dev stack's CORS allowlist
# covers localhost:3000). The PRODUCTION web image does NOT read this at
# runtime -- its origin is baked at image-build time (NEXT_PUBLIC_API_BASE_URL
# ARG, same-origin "" default, in apps/web/infra/docker/web.Dockerfile) --
# so leave it unset/absent in production .env files.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Production-only (docker-compose.prod.yml) -- required, no default.
# Leave unset for local `docker compose up` (docker-compose.yml alone
# never reads these). ---
# API_IMAGE_TAG=ghcr.io/your-org/nurseryverse-api:1.0.0
# WORKER_IMAGE_TAG=ghcr.io/your-org/nurseryverse-worker:1.0.0
# WEB_IMAGE_TAG=ghcr.io/your-org/nurseryverse-web:1.0.0
# API_WEB_CONCURRENCY=4
# TLS_CERT_DIR=/etc/letsencrypt/live/your-domain

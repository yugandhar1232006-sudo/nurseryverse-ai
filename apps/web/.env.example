# Base URL of the real NurseryVerse AI backend (apps/api). The frontend
# never talks to anything but this -- no mock server, no static fixtures.
#
# Local dev default: docker-compose.yml's api service (port 8000), the
# same cross-origin setup the e2e suite and local `npm run dev` use.
#
# Production: the web Docker image bakes NEXT_PUBLIC_API_BASE_URL at build
# time via a build ARG whose default is "" (empty string) -- same-origin.
# Empty means "call relative /api/v1/... through Nginx" (infra/nginx/
# conf.d/default.conf routes /api/* and /ws/* to the api upstream), which
# is exactly how docs/architecture/01-high-level-architecture.md §7's
# "frontend talks to the FastAPI backend over same-origin HTTPS (proxied
# by Nginx)" is satisfied. That value is set in apps/web/infra/docker/
# web.Dockerfile, never in a production .env file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
